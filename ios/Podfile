require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

platform :ios, '15.1'
install! 'cocoapods', :deterministic_uuids => false

# Pin the generated workspace name so `react-native run-ios` selects it and
# infers the matching RocketChat scheme without a --scheme flag.
workspace 'RocketChat'

prepare_react_native_project!

def all_pods
  pod 'simdjson', path: '../node_modules/@nozbe/simdjson', modular_headers: true
  pod 'MMKV', :modular_headers => true
  pod 'MMKVCore', :modular_headers => true
  $RNFirebaseAnalyticsWithoutAdIdSupport = true

  use_expo_modules!
  config = use_native_modules!

  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
  
end

abstract_target 'defaults' do

  all_pods

  target 'Rocket.Chat'
  target 'NotificationService'
end

$static_framework = [ 
  'WatermelonDB',
  'simdjson'
]
pre_install do |installer|
  Pod::Installer::Xcode::TargetValidator.send(:define_method, :verify_no_static_framework_transitive_dependencies) {}
    installer.pod_targets.each do |pod|
      if $static_framework.include?(pod.name)
        def pod.build_type;
        Pod::BuildType.static_library # >= 1.9
      end
    end
  end
end

post_install do |installer|
  # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
  react_native_post_install(
    installer,
    # config[:reactNativePath],
    # :mac_catalyst_enabled => false,
    # :ccache_enabled => true
  )

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
      # Some Expo pod headers trigger nullability warnings in recent Xcode toolchains.
      # Keep pod builds resilient for Archive/TestFlight by not promoting these warnings.
      config.build_settings['CLANG_WARN_NULLABILITY_COMPLETENESS'] = 'NO'
      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      config.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      config.build_settings['WARNING_CFLAGS'] = '$(inherited) -Wno-nullability-completeness -Wno-error=nullability-completeness -Wno-error=deprecated-declarations'
      config.build_settings['OTHER_CFLAGS'] = '$(inherited) -Wno-nullability-completeness -Wno-error=nullability-completeness -Wno-error=deprecated-declarations'
      current_min_ios = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current_min_ios.nil? || current_min_ios.to_f < 12.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
      end
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ""
      config.build_settings['CODE_SIGNING_REQUIRED'] = "NO"
      config.build_settings['CODE_SIGNING_ALLOWED'] = "NO"
      config.build_settings['ENABLE_BITCODE'] = "NO"
      
      # Add SecureStorage headers to search paths for react-native-webview
      if target.name == 'react-native-webview'
        config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
        config.build_settings['HEADER_SEARCH_PATHS'] << '$(SRCROOT)/..'
      end

      # Workaround global for fmt + clang consteval issue in some Xcode toolchains.
      current_flags = config.build_settings['OTHER_CPLUSPLUSFLAGS']
      case current_flags
      when Array
        current_flags << '-DFMT_USE_CONSTEVAL=0' unless current_flags.include?('-DFMT_USE_CONSTEVAL=0')
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = current_flags
      when String
        unless current_flags.include?('-DFMT_USE_CONSTEVAL=0')
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{current_flags} -DFMT_USE_CONSTEVAL=0"
        end
      else
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -DFMT_USE_CONSTEVAL=0'
      end

      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
      case defs
      when Array
        defs << 'FMT_USE_CONSTEVAL=0' unless defs.include?('FMT_USE_CONSTEVAL=0')
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
      when String
        unless defs.include?('FMT_USE_CONSTEVAL=0')
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = "#{defs} FMT_USE_CONSTEVAL=0"
        end
      else
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = ['$(inherited)', 'FMT_USE_CONSTEVAL=0']
      end
    end
  end

  # Also apply the fmt workaround to user project targets because some app/extension
  # compilation units include fmt headers directly through transitive includes.
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |native_target|
      native_target.build_configurations.each do |config|
        current_flags = config.build_settings['OTHER_CPLUSPLUSFLAGS']
        case current_flags
        when Array
          current_flags << '-DFMT_USE_CONSTEVAL=0' unless current_flags.include?('-DFMT_USE_CONSTEVAL=0')
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = current_flags
        when String
          unless current_flags.include?('-DFMT_USE_CONSTEVAL=0')
            config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{current_flags} -DFMT_USE_CONSTEVAL=0"
          end
        else
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -DFMT_USE_CONSTEVAL=0'
        end

        defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
        case defs
        when Array
          defs << 'FMT_USE_CONSTEVAL=0' unless defs.include?('FMT_USE_CONSTEVAL=0')
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
        when String
          unless defs.include?('FMT_USE_CONSTEVAL=0')
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = "#{defs} FMT_USE_CONSTEVAL=0"
          end
        else
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = ['$(inherited)', 'FMT_USE_CONSTEVAL=0']
        end
      end
    end
    aggregate_target.user_project.save
  end

  # Persist fmt consteval workaround across pod install by patching fmt/base.h
  # to honor externally provided FMT_USE_CONSTEVAL.
  fmt_base_h = File.join(installer.sandbox.root, 'fmt/include/fmt/base.h')
  if File.exist?(fmt_base_h)
    content = File.read(fmt_base_h)
    original = "// Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.\n#if !defined(__cpp_lib_is_constant_evaluated)"
    patched = "// Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.\n#if defined(FMT_USE_CONSTEVAL)\n// Use the provided definition.\n#elif !defined(__cpp_lib_is_constant_evaluated)"
    updated = content
    if updated.include?(original)
      updated = updated.sub(original, patched)
    end

    # Apple clang in recent Xcode can still fail consteval checks in fmt v11.
    # Force-disable on Apple toolchains to avoid format-inl.h build errors.
    apple_probe = "#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L"
    apple_forced = "#elif defined(__apple_build_version__)"
    if updated.include?(apple_probe)
      updated = updated.sub(apple_probe, apple_forced)
    end

    if updated != content
      File.write(fmt_base_h, updated)
    end
  end

  bitcode_strip_path = `xcrun --find bitcode_strip`.chop!
  def strip_bitcode_from_framework(bitcode_strip_path, framework_relative_path)
    framework_path = File.join(Dir.pwd, framework_relative_path)
    command = "#{bitcode_strip_path} #{framework_path} -r -o #{framework_path}"
    puts "Stripping bitcode: #{command}"
    system(command)
  end
end
